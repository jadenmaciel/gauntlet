# Makefile fragment: crap4rs + pinned gauntlet adapter checkout.
#
# Copy the pieces you need into your repo's real Makefile.

BIN_DIR ?= bin
BASE_BRANCH ?= main
THRESHOLDS_FILE ?= .gauntlet/thresholds.yml
COVERAGE_FILE ?= target/llvm-cov.json

GAUNTLET_VERSION ?= v0.2.0
GAUNTLET_CHECKOUT_DIR ?= .gauntlet-tools/gauntlet
CARGO_LLVM_COV_VERSION ?= 0.6.21

.PHONY: crap4rs-tools
crap4rs-tools:
	test -n "$(GAUNTLET_VERSION)" || { echo "Set GAUNTLET_VERSION to a gauntlet tag (v0.2.0 or later)"; exit 2; }
	rustup component add llvm-tools-preview
	cargo install cargo-llvm-cov --version $(CARGO_LLVM_COV_VERSION) --locked
	test -d "$(GAUNTLET_CHECKOUT_DIR)" || git clone --depth 1 --branch $(GAUNTLET_VERSION) https://github.com/jadenmaciel/gauntlet "$(GAUNTLET_CHECKOUT_DIR)"
	git -C "$(GAUNTLET_CHECKOUT_DIR)" fetch --tags --force
	git -C "$(GAUNTLET_CHECKOUT_DIR)" checkout "$(GAUNTLET_VERSION)"
	cargo install --path "$(GAUNTLET_CHECKOUT_DIR)/adapters/rust/crap4rs" --locked --root "$(abspath $(BIN_DIR)/..)"

.PHONY: rust-coverage
rust-coverage: crap4rs-tools
	cargo llvm-cov --json --output-path "$(COVERAGE_FILE)"

.PHONY: crap-rust
crap-rust: rust-coverage
	$(BIN_DIR)/crap4rs --dir . --coverage "$(COVERAGE_FILE)" --thresholds $(THRESHOLDS_FILE) --changed origin/$(BASE_BRANCH)

.PHONY: crap-rust-all
crap-rust-all: rust-coverage
	$(BIN_DIR)/crap4rs --dir . --coverage "$(COVERAGE_FILE)" --thresholds $(THRESHOLDS_FILE)
