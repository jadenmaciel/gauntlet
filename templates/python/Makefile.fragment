# Makefile fragment: coverage.py + crap4py
#
# Copy the pieces you need into your repo's real Makefile. Keep your existing
# test command if it is not pytest.

PYTHON ?= python3
BASE_BRANCH ?= main
THRESHOLDS_FILE ?= .gauntlet/thresholds.yml
COVERAGE_FILE ?= coverage.xml

.PHONY: coverage-xml
coverage-xml:
	$(PYTHON) -m coverage run -m pytest
	$(PYTHON) -m coverage xml -o $(COVERAGE_FILE)

.PHONY: crap
crap: coverage-xml
	crap4py --dir . --coverage $(COVERAGE_FILE) --thresholds $(THRESHOLDS_FILE) --changed origin/$(BASE_BRANCH)

.PHONY: crap-all
crap-all: coverage-xml
	crap4py --dir . --coverage $(COVERAGE_FILE) --thresholds $(THRESHOLDS_FILE)
