# Makefile fragment: crap4go + gremlins mutation testing + pinned tools
#
# Copy the pieces you need into your repo's real Makefile. Variable names
# (BIN_DIR, BASE_BRANCH, THRESHOLDS_FILE, module paths) are placeholders —
# match them to what your repo already uses before pasting.

BIN_DIR ?= bin
BASE_BRANCH ?= main

# crap4go reads this file itself via --thresholds. gremlins cannot, so its
# floor is still scraped out with awk below.
THRESHOLDS_FILE ?= .gauntlet/thresholds.yml
COVERAGE_FILE ?= coverage.out
MCOVER_FLOOR := $(shell awk '/^  mutation_mcover:/{found=1; next} found && /^    value:/{print $$2; exit}' $(THRESHOLDS_FILE))

# Pin crap4go and gauntlet to a release tag. Do not float on latest.
CRAP4GO_VERSION ?= v0.2.0
GAUNTLET_VERSION ?= v0.2.0
GREMLINS_VERSION ?= latest

.PHONY: gauntlet-tools
gauntlet-tools:
	GOBIN=$(abspath $(BIN_DIR)) go install github.com/jadenmaciel/gauntlet/cmd/crap4go@$(CRAP4GO_VERSION)
	GOBIN=$(abspath $(BIN_DIR)) go install github.com/jadenmaciel/gauntlet/cmd/gauntlet@$(GAUNTLET_VERSION)
	GOBIN=$(abspath $(BIN_DIR)) go install github.com/go-gremlins/gremlins@$(GREMLINS_VERSION)

.PHONY: crap
crap: cover gauntlet-tools
	$(BIN_DIR)/crap4go --dir . --coverage $(COVERAGE_FILE) --thresholds $(THRESHOLDS_FILE) --changed origin/$(BASE_BRANCH)

.PHONY: crap-all
crap-all: cover gauntlet-tools
	$(BIN_DIR)/crap4go --dir . --coverage $(COVERAGE_FILE) --thresholds $(THRESHOLDS_FILE)

.PHONY: mutation
mutation: gauntlet-tools
	$(BIN_DIR)/gremlins unleash \
		--threshold-efficacy 95 \
		--threshold-mcover $(MCOVER_FLOOR) \
		--timeout-coefficient 50 \
		--output mutation.json
# timeout-coefficient 50 is a starting point, verified against this repo's
# real measured mutation-run timeouts — not a gremlins default and not a
# universal number. Re-measure and tune per repo: too low kills slow-but-
# correct mutant runs as false timeouts; too high wastes CI time on
# mutants that hang.

# Add `crap` (and `mutation`, if run in CI rather than nightly) as a
# prerequisite of this repo's existing check target:
#
# .PHONY: check
# check: lint test crap
