# Makefile fragment: crap4php + gauntlet thresholds
#
# Copy these targets into your repo's Makefile and adjust variables.
# This fragment assumes you vendored adapters/php/crap4php into tools/crap4php.

PHP ?= php
COMPOSER ?= composer
BASE_BRANCH ?= main
CRAP4PHP_DIR ?= tools/crap4php
THRESHOLDS_FILE ?= .gauntlet/thresholds.yml
COVERAGE_FILE ?= build/coverage/clover.xml
CRAP4PHP_SOURCE_DIR ?= src

.PHONY: gauntlet-tools-php
gauntlet-tools-php:
	$(COMPOSER) install --working-dir $(CRAP4PHP_DIR) --no-interaction --prefer-dist

.PHONY: cover-php
cover-php:
	vendor/bin/phpunit --coverage-clover $(COVERAGE_FILE)

.PHONY: crap-php
crap-php: cover-php gauntlet-tools-php
	$(PHP) $(CRAP4PHP_DIR)/bin/crap4php --dir $(CRAP4PHP_SOURCE_DIR) --coverage $(COVERAGE_FILE) \
		--thresholds $(THRESHOLDS_FILE) --changed origin/$(BASE_BRANCH)

.PHONY: crap-php-all
crap-php-all: cover-php gauntlet-tools-php
	$(PHP) $(CRAP4PHP_DIR)/bin/crap4php --dir $(CRAP4PHP_SOURCE_DIR) --coverage $(COVERAGE_FILE) \
		--thresholds $(THRESHOLDS_FILE)

# Add `crap-php` to your existing check target, for example:
#
# .PHONY: check
# check: lint test crap-php
