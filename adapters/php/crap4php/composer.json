{
  "name": "jadenmaciel/crap4php",
  "description": "CRAP scorer for PHP using cyclomatic complexity and clover coverage",
  "type": "project",
  "require": {
    "nikic/php-parser": "^5.0",
    "symfony/yaml": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Gauntlet\\Crap4Php\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gauntlet\\Crap4Php\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
